{
  "manifest_version": 3,
  "name": "JiraTack",
  "version": "0.1.0",
  "description": "Drop pins on any page and turn them into Jira tickets.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JiraTack: pin this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "109",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.hello.atlassian-dev.net/*"
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.hello.atlassian-dev.net/*",
      "https://*.atlassian.net/*"
    ]
  }
}
