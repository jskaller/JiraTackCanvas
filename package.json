{
  "name": "jiratack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:bookmarklet": "vite build --config vite.bookmarklet.config.js",
    "build:dashboard": "vite build --config vite.dashboard.config.js",
    "build": "npm run build:bookmarklet && npm run build:dashboard && node scripts/embed-sdk.js",
    "deploy": "forge deploy -e development",
    "tunnel": "forge tunnel",
    "build:extension": "node scripts/build-extension.js",
    "icons": "node scripts/make-icons.js",
    "test:unit": "node --import ./scripts/test-support/register.mjs --test src/shared/*.test.js src/lib/*.test.js src/bookmarklet/*.test.js",
    "test:resolvers": "node --import ./scripts/test-support/register.mjs --test src/resolvers/actions/*.test.js src/webtrigger/actions/*.test.js",
    "test": "npm run test:unit && npm run test:resolvers",
    "test:extension": "node scripts/extension-harness/run.mjs",
    "baseline:check": "node scripts/baseline.mjs check",
    "baseline:record": "node scripts/baseline.mjs record"
  },
  "dependencies": {
    "@forge/api": "^4",
    "@forge/bridge": "^5",
    "@forge/kvs": "^1",
    "@forge/react": "^11",
    "@forge/resolver": "^1",
    "html2canvas": "^1.4",
    "jsonwebtoken": "^9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "forge-cli": "latest",
    "react": "^18",
    "react-dom": "^18",
    "vite": "^5"
  }
}
